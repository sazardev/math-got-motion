{
  "name": "math-got-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:android": "tauri android dev",
    "tauri:build:android": "tauri android build",
    "tauri:dev:ios": "tauri ios dev",
    "tauri:build:ios": "tauri ios build",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,html,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css,html,md}'",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check",
    "analyze": "vite build --mode analyze",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy --fix --all-targets --all-features --allow-dirty",
    "rust:audit": "cd src-tauri && cargo audit",
    "rust:deny": "cd src-tauri && cargo deny check",
    "rust:outdated": "cd src-tauri && cargo outdated",
    "rust:udeps": "cd src-tauri && cargo udeps --all-targets",
    "rust:check": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:audit && pnpm rust:deny",
    "check:everything": "pnpm check:all && pnpm rust:check",
    "prepare": "husky",
    "clean": "rm -rf dist node_modules/.vite src-tauri/target"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.0.4",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-inspect": "^11.4.1"
  }
}
