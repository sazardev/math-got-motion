{
  "name": "math-got-motion",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:android": "tauri android dev",
    "tauri:build:android": "tauri android build",
    "tauri:dev:ios": "tauri ios dev",
    "tauri:build:ios": "tauri ios build",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'scripts/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'scripts/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,yaml,yml,css,html,md}' 'scripts/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,yaml,yml,css,html,md}' 'scripts/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "formulas:validate": "tsx scripts/validate-formulas.ts",
    "changelog:sync": "tsx scripts/sync-changelog-md.ts",
    "generate-og": "tsx scripts/generate-og-images.tsx",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "prerender": "tsx scripts/prerender.ts",
    "build:web": "pnpm build && pnpm generate-og && pnpm generate-sitemap && pnpm prerender",
    "check:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm formulas:validate",
    "analyze": "vite build --mode analyze",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy --fix --all-targets --all-features --allow-dirty",
    "rust:audit": "cd src-tauri && cargo audit",
    "rust:deny": "cd src-tauri && cargo deny check",
    "rust:outdated": "cd src-tauri && cargo outdated",
    "rust:udeps": "cd src-tauri && cargo udeps --all-targets",
    "rust:check": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:audit && pnpm rust:deny",
    "check:everything": "pnpm check:all && pnpm rust:check",
    "prepare": "husky",
    "clean": "rm -rf dist node_modules/.vite src-tauri/target"
  },
  "dependencies": {
